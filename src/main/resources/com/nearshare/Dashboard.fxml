<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<!--
  Root layout is a BorderPane (top = header, center = main content).
  The center is an HBox containing a fixed-width send panel and a TabPane
  that grows with the window (HBox.hgrow="ALWAYS"), and every TableView
  uses CONSTRAINED_RESIZE_POLICY so its columns rescale with the window
  instead of leaving dead space - this is what makes the UI responsive to
  window width/height rather than fixed-pixel.
-->
<BorderPane xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.nearshare.MainController"
            styleClass="root-pane">

    <top>
        <HBox styleClass="header-bar" spacing="24" alignment="CENTER_LEFT">
            <padding><Insets top="16" right="24" bottom="16" left="24"/></padding>

            <VBox spacing="2">
                <Label text="NearShare" styleClass="app-title"/>
                <Label text="Fast peer-to-peer LAN file transfer" styleClass="app-subtitle"/>
            </VBox>

            <Region HBox.hgrow="ALWAYS"/>

            <HBox styleClass="ip-badge" spacing="8" alignment="CENTER_LEFT">
                <Label text="Your IP:" styleClass="badge-label"/>
                <Label fx:id="localIpLabel" text="0.0.0.0" styleClass="ip-value"/>
                <Button fx:id="copyIpBtn" text="📋 Copy" onAction="#onCopyIpClicked" styleClass="copy-btn"/>
            </HBox>

            <HBox spacing="8" alignment="CENTER_LEFT" styleClass="status-group">
                <Label fx:id="statusDot" styleClass="status-dot, status-dot-active"/>
                <Label fx:id="statusLabel" text="Ready" styleClass="status-text"/>
            </HBox>

            <Label fx:id="scanTimeLabel" text="Uptime: 00:00:00" styleClass="uptime-label"/>
        </HBox>
    </top>

    <center>
        <HBox styleClass="main-content" spacing="18">
            <padding><Insets top="18" right="24" bottom="18" left="24"/></padding>

            <!-- ===================== SEND PANEL ===================== -->
            <VBox styleClass="panel, send-panel" spacing="12" prefWidth="360" minWidth="320" HBox.hgrow="NEVER">

                <Label text="Send a File" styleClass="panel-title"/>

                <StackPane fx:id="dropZone" styleClass="drop-zone" prefHeight="160" VBox.vgrow="NEVER">
                    <VBox alignment="CENTER" spacing="6">
                        <Label text="📁" styleClass="drop-icon"/>
                        <Label text="Drag &amp; drop a file here" styleClass="drop-text"/>
                        <Label text="or" styleClass="drop-sub"/>
                        <Button text="Browse Files" onAction="#onBrowseFileClicked" styleClass="browse-btn"/>
                    </VBox>
                </StackPane>

                <HBox fx:id="selectedFileBox" styleClass="selected-file-box" spacing="10"
                      alignment="CENTER_LEFT" visible="false" managed="false">
                    <VBox HBox.hgrow="ALWAYS" spacing="1">
                        <Label fx:id="selectedFileNameLabel" text="filename.ext" styleClass="file-name"/>
                        <Label fx:id="selectedFileSizeLabel" text="0 KB" styleClass="file-size"/>
                    </VBox>
                    <Button text="✕" onAction="#onClearSelectedFile" styleClass="clear-file-btn"/>
                </HBox>

                <Separator/>

                <Label text="Receiver's IP Address" styleClass="field-label"/>
                <TextField fx:id="targetIpField" promptText="e.g. 192.168.1.24"/>

                <Label text="Their PIN (only if they require one)" styleClass="field-label"/>
                <PasswordField fx:id="sendPinField" promptText="Leave blank if none"/>

                <Button fx:id="sendButton" text="🚀 Send File" onAction="#onSendButtonClicked"
                        styleClass="send-btn" maxWidth="Infinity"/>

                <ProgressBar fx:id="transferProgressBar" maxWidth="Infinity"
                             visible="false" managed="false" styleClass="transfer-bar"/>

                <Separator/>

                <Label text="Security" styleClass="panel-title-sm"/>
                <PasswordField fx:id="myPinField" promptText="Set a PIN to require for incoming files"/>
                <HBox spacing="10" alignment="CENTER_LEFT">
                    <CheckBox fx:id="requirePinCheck" text="Require PIN for incoming transfers"/>
                    <Region HBox.hgrow="ALWAYS"/>
                    <Button text="Save" onAction="#onSavePinClicked" styleClass="secondary-btn"/>
                </HBox>

            </VBox>

            <!-- ===================== RIGHT SIDE: TABS ===================== -->
            <TabPane HBox.hgrow="ALWAYS" styleClass="main-tabs" tabClosingPolicy="UNAVAILABLE">

                <Tab text="History">
                    <VBox styleClass="tab-content" spacing="12">
                        <padding><Insets top="16" right="16" bottom="16" left="16"/></padding>

                        <HBox spacing="10" alignment="CENTER_LEFT">
                            <TextField fx:id="searchField" promptText="🔎 Search by file, IP, direction, or note..."
                                       HBox.hgrow="ALWAYS"/>
                            <Button text="🗑 Delete" onAction="#onDeleteSelectedHistory" styleClass="secondary-btn"/>
                            <Button text="Clear All" onAction="#onClearHistoryClicked" styleClass="secondary-btn"/>
                            <Button text="📂 Downloads" onAction="#onOpenDownloadsClicked" styleClass="secondary-btn"/>
                        </HBox>

                        <TableView fx:id="historyTable" VBox.vgrow="ALWAYS">
                            <columnResizePolicy>
                                <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
                            </columnResizePolicy>
                            <columns>
                                <TableColumn fx:id="colFile" text="File" prefWidth="150"/>
                                <TableColumn fx:id="colDirection" text="Direction" prefWidth="110"/>
                                <TableColumn fx:id="colPeer" text="Peer IP" prefWidth="110"/>
                                <TableColumn fx:id="colSize" text="Size" prefWidth="80"/>
                                <TableColumn fx:id="colTime" text="Timestamp" prefWidth="140"/>
                                <TableColumn fx:id="colDuration" text="Duration" prefWidth="80"/>
                                <TableColumn fx:id="colNote" text="Note (double-click to edit)" prefWidth="160"/>
                            </columns>
                        </TableView>

                        <HBox styleClass="stats-bar" spacing="24" alignment="CENTER_LEFT">
                            <Label text="⬆ Sent:" styleClass="stat-label"/>
                            <Label fx:id="totalSentLabel" text="0" styleClass="stat-value"/>
                            <Label text="⬇ Received:" styleClass="stat-label"/>
                            <Label fx:id="totalReceivedLabel" text="0" styleClass="stat-value"/>
                            <Region HBox.hgrow="ALWAYS"/>
                            <Label fx:id="historyCountLabel" text="0 transfers" styleClass="hint-text"/>
                        </HBox>
                    </VBox>
                </Tab>

                <Tab text="Devices &amp; Network">
                    <VBox styleClass="tab-content" spacing="14">
                        <padding><Insets top="16" right="16" bottom="16" left="16"/></padding>

                        <HBox spacing="10" alignment="CENTER_LEFT">
                            <Label text="Known Devices on Your LAN" styleClass="panel-title"/>
                            <Region HBox.hgrow="ALWAYS"/>
                            <Button fx:id="scanButton" text="🔍 Scan Network" onAction="#onScanNetworkClicked"
                                    styleClass="send-btn"/>
                        </HBox>
                        <Label fx:id="scanStatusLabel" text="Not scanned yet." styleClass="hint-text"/>

                        <TableView fx:id="devicesTable" prefHeight="220" VBox.vgrow="SOMETIMES">
                            <columnResizePolicy>
                                <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
                            </columnResizePolicy>
                            <columns>
                                <TableColumn fx:id="colDeviceName" text="Name" prefWidth="160"/>
                                <TableColumn fx:id="colDeviceIp" text="IP Address" prefWidth="130"/>
                                <TableColumn fx:id="colDeviceLastSeen" text="Last Seen" prefWidth="160"/>
                                <TableColumn fx:id="colDeviceStatus" text="Status" prefWidth="100"/>
                            </columns>
                        </TableView>

                        <Separator/>

                        <HBox spacing="10" alignment="CENTER_LEFT">
                            <Label text="Your Public Internet Info" styleClass="panel-title"/>
                            <Region HBox.hgrow="ALWAYS"/>
                            <Button fx:id="checkPublicInfoButton" text="🌐 Check" onAction="#onCheckPublicInfoClicked"
                                    styleClass="secondary-btn"/>
                        </HBox>

                        <VBox styleClass="info-card" spacing="6">
                            <Label fx:id="publicIpLabel" text="Public IP: —"/>
                            <Label fx:id="publicLocationLabel" text="Location: —"/>
                            <Label fx:id="publicIspLabel" text="ISP: —"/>
                        </VBox>
                    </VBox>
                </Tab>

            </TabPane>

        </HBox>
    </center>

</BorderPane>
